{
  "name": "agendas-prado",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --config wrangler.local.jsonc",
    "build": "node scripts/build-native.mjs",
    "test": "node scripts/check-worker.mjs && node --experimental-strip-types --test tests/unit/*.test.ts",
    "preview": "npm run dev",
    "check:migrations": "node scripts/check-migration-safety.mjs",
    "test:bootstrap-admin": "node scripts/check-bootstrap-admin.mjs",
    "bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "verify:production": "npm run check:migrations && npm test && npm run test:bootstrap-admin && npm run build && node scripts/check-build.mjs && node scripts/build-modern-preview.mjs",
    "deploy:cloudflare": "node scripts/block-v2-remote.mjs",
    "db:migrate:preview:agendas": "node scripts/block-v2-remote.mjs",
    "deploy:preview": "node scripts/block-v2-remote.mjs",
    "deploy": "node scripts/block-v2-remote.mjs",
    "benchmark:password": "node --experimental-strip-types scripts/benchmark-password.mjs",
    "benchmark:agendas": "node --experimental-strip-types scripts/benchmark-agendas.mjs",
    "db:migrate:preview": "node scripts/block-v2-remote.mjs",
    "dev:mock": "npm run build && node scripts/dev-mock-node.mjs",
    "mock:seed": "node scripts/dev-mock-node.mjs --seed-only",
    "dev:mock:wrangler": "npm run build && node scripts/dev-mock.mjs",
    "mock:seed:wrangler": "node scripts/dev-mock.mjs --seed-only"
  },
  "dependencies": {
    "@llamaindex/liteparse-wasm": "^2.18.0",
    "hono": "^4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "wrangler": "4.161.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
