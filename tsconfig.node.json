{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./apps/web/node_modules/@types"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "worker/types.d.ts",
    "worker/pdf-types.d.ts",
    "tests/helpers/**/*.ts",
    "tests/unit/**/*.ts",
    "shared/**/*.ts"
  ]
}
