    "tests/unit/worker-utils.test.ts",
    "tests/unit/shared-contracts.test.ts",
    "tests/unit/csv-decoding.test.ts",
    "tests/unit/password-security.test.ts",
    "tests/unit/release-agendas-migrations.test.ts",
    "tests/unit/pdf-text-contract.test.ts",
    "tests/unit/app-contract.test.ts",
    "tests/unit/routes-parity.test.ts",
    "tests/unit/auth-contract.test.ts",
    "tests/unit/agenda-routes-parity.test.ts",
    "tests/unit/validate-import-batch.test.ts",
    "tests/helpers/**/*.ts",
    "tests/unit/admin-agendas-pagination.test.ts",
    "tests/unit/agenda-concurrency-integrated.test.ts",
    "tests/unit/agenda-digitacao-fornecedor.test.ts",
    "tests/unit/auth-integration-synthetic.test.ts",
    "tests/unit/diagnostics.test.ts",
    "tests/unit/migrations-worker-smoke.test.ts",
    "tests/unit/mutation-origin-security.test.ts",
    "tests/unit/recebimento-api-integrated.test.ts",
    "tests/unit/session-revocation.test.ts",
    "tests/unit/concurrency-guards.test.ts",
    "tests/unit/retention.test.ts",
    "tests/unit/agenda-digitado.test.ts",
    "tests/unit/agenda-import-bulk-replace.test.ts",
    "tests/unit/agenda-nonattendance.test.ts",
    "tests/unit/agenda-status.test.ts",
    "tests/unit/repositories-services.test.ts"
  ]
