{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./apps/web/node_modules/@types"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "worker/types.d.ts",
    "worker/pdf-types.d.ts",
    "tests/unit/benchmark-agendas.test.ts",
    "tests/unit/worker-utils.test.ts",
    "tests/unit/shared-contracts.test.ts",
    "tests/unit/csv-decoding.test.ts",
    "tests/unit/password-security.test.ts",
    "tests/unit/release-agendas-migrations.test.ts",
    "tests/unit/pdf-text-contract.test.ts",
    "tests/unit/app-contract.test.ts",
    "tests/unit/routes-parity.test.ts",
    "tests/unit/auth-contract.test.ts",
    "tests/unit/agenda-routes-parity.test.ts",
    "tests/unit/validate-import-batch.test.ts"
  ]
}
