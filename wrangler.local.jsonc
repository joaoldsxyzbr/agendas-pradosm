// Somente ambiente LOCAL V2, sem D1 remoto.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agendas-pradosm-v2-local",
  "compatibility_date": "2026-09-24",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agendas-pradosm-v2-local",
      "database_id": "00000000-0000-4000-8000-000000000003",
      "migrations_dir": "migrations-v2"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026101801",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2-local-v1",
      "new_sqlite_classes": [
        "RealtimeHub"
      ]
    }
  ],
  "vars": {
    "REALTIME_MODE": "off",
    "ACCESS_MODE": "on"
  }
}
