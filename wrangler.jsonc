// V2: somente dry-run até provisionamento e autorização explícita.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agendas-pradosm-v2-dry-run",
  "compatibility_date": "2026-09-24",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ],
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agendas-pradosm-v2-unconfigured",
      "database_id": "00000000-0000-4000-8000-000000000002",
      "migrations_dir": "migrations-v2"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026112702",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.05
    },
    "redact_query_string": true
  },
  "secrets": {
    "required": [
      "SESSION_SECRET"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "exports": {
    "RealtimeHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "REALTIME_MODE": "off",
    "ACCESS_MODE": "on"
  }
}
